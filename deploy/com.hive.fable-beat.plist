<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs the Fable agent's heartbeat every 30 minutes — the Hive's
     self-improvement loop (see scripts/fable-beat.sh).
     Install:
       cp deploy/com.hive.fable-beat.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.hive.fable-beat.plist
     Watch: tail -f ~/Library/Logs/hive-fable-beat.log -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.hive.fable-beat</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/kos2001/gitspace/slsi-chrome-share/scripts/fable-beat.sh</string>
  </array>
  <key>StartInterval</key><integer>1800</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/kos2001/Library/Logs/hive-fable-beat.log</string>
  <key>StandardErrorPath</key><string>/Users/kos2001/Library/Logs/hive-fable-beat.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
